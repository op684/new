{
  "name": "ps4-scripthook-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for driving a jailbroken PlayStation 4 (GoldHEN + ps4debug) and the OrbisScriptHook mod runtime",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ps4-scripthook-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "node --test dist/../test/*.test.js",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
